{
  "manifest_version": 3,
  "name": "YTMusic Awaker",
  "version": "1.0.0",
  "description": "Prevents YouTube Music background tab freezing, render eviction, and blank page lag during high RAM usage.",
  "action": {
    "default_title": "YTMusic Awaker",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
